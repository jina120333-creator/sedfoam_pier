FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rbgh;
}
// ************************************************************************* //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inletWater
    {
        type            zeroGradient;
    }

    inletSediment
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    outletWater
    {
        type            fixedValue;
        value           uniform 0;
    }
