*/
    
    outletSediment
    {
        //type          zeroGradient;
        type            fixedFluxPressure;
        value           uniform 0;
    }

    sideWalls
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }

    bottom
    {
        type            fixedFluxPressure; //zeroGradient;
        value           uniform 0;
    }

    top
    {
        type            fixedValue; //zeroGradient;
        value           uniform 0;
    }

    pier
    {
        type            fixedFluxPressure;
        value           uniform 0;
    }
}

