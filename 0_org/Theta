FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Theta;
}
// ************************************************************************* //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 1e-6;

boundaryField
{
    inletWater
    {
        type            fixedValue;
        value           uniform 1e-6;
        //type            zeroGradient;
    }

    inletSediment
    {
        type            zeroGradient;
    }

    outletWater
    {
        type            zeroGradient;
    }

    outletSediment
    {
        type            zeroGradient;
    }

    sideWalls
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    pier
    {
        type            zeroGradient;
    }
}

