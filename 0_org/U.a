FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U.a;
}
// ************************************************************************* //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inletWater
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    
	inletSediment
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    outletWater
    {
        type            inletOutlet;
		inletValue		uniform (0 0 0);
		value			uniform (0 0 0);
        //type            zeroGradient;
    }

    outletSediment
    {
        type            inletOutlet;
		inletValue		uniform (0 0 0);
		value			uniform (0 0 0);
		//type            fixedValue;
	    //value           uniform (0 0 0);
	}

	sideWalls
    {
        type			noSlip;
		//type            fixedValue;
        //value           uniform (0 0 0);
    }

    bottom
    {
        type			noSlip;
		//type            fixedValue;
        //value           uniform (0 0 0);
    }

    top
    {
        type			slip;
		//type            zeroGradient;
    }

    pier
    {
        type			noSlip;
		//type            fixedValue;
        //value           uniform (0 0 0);
    }
}

// ************************************************************************* //
