FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.a;
}
// ************************************************************************* //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inletWater
    {
        //type            zeroGradient;
		type            fixedValue;
	    value           uniform 0;
    }

    inletSediment
    {
        type            zeroGradient;
    }

    outletWater
    {
        type            zeroGradient;
        /*
		type            inletOutlet;
		inletValue		uniform 0;
		value			uniform 0;
		*/
    }

    outletSediment
    {
        type            zeroGradient;
    }

    sideWalls
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }

    top
    {
        type            zeroGradient;
    }

    pier
    {
        type            zeroGradient;
    }
}

// ************************************************************************* //
